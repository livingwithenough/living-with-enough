# Server/build only. Never prefix secrets with NEXT_PUBLIC_.
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=
# Set your verified production origin before deployment; rebuild after changing.
SITE_URL=http://127.0.0.1:3000


# Public GA4 web-stream ID (not a secret). Blank disables Google Analytics.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Exact hostname allowed to send; previews and localhost stay unmeasured by default.
NEXT_PUBLIC_GA4_HOSTNAME=living-with-enough.pages.dev
